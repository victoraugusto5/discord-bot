import discord
import random

intents = discord.Intents.default()
intents.message_content = True

client = discord.Client(intents=intents)

jogos = {}  

@client.event
async def on_ready():
    print(f'Logado como {client.user}')

async def cmd_hello(message):
    await message.channel.send("Hello!")


async def cmd_bye(message):
    await message.channel.send("🙂")

async def cmd_emoji(message):
    await message.channel.send("😂​")

async def cmd_adivinhar(message):
    if message.author.id in jogos:
        await message.channel.send("⚠️ Você já está em um jogo!")
        return
    numero = random.randint(1, 20)
    jogos[message.author.id] = {
        "numero": numero,
        "tentativas": 5
    }
    await message.channel.send(
        "Pensei em um número de **1 a 20**.\n"
        "Você tem **5 tentativas**. Envie um número!"
    )

async def cmd_tentativa(message):
    user_id = message.author.id
    content = message.content.strip()

    if user_id not in jogos:
        return  
    if not content.isdigit():
        return

    tentativa = int(content)
    jogo = jogos[user_id]
    jogo["tentativas"] -= 1

    if tentativa > jogo["numero"]:
        await message.channel.send("O número é menor.")
    elif tentativa < jogo["numero"]:
        await message.channel.send("O número é maior.")
    else:
        await message.channel.send("🎉 Você acertou!")
        del jogos[user_id]
        return

    if jogo["tentativas"] <= 0:
        await message.channel.send(f"Acabaram as tentativas. O número era {jogo['numero']}.")
        del jogos[user_id]

@client.event
async def on_message(message):
    if message.author == client.user:
        return
    if message.content == '$hello':
        await cmd_hello(message)

    elif message.content == '$bye':
        await cmd_bye(message)
    
    elif message.content == '$emoji':
        await cmd_emoji(message)
    
    elif message.content == '$adivinhar':
        await cmd_adivinhar(message)

    elif message.author.id in jogos and message.content.isdigit():
        await cmd_tentativa(message)
    else:
        await message.channel.send(message.content) 
