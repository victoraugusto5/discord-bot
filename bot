import discord
from discord.ext import commands
import random

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='$', intents=intents)

jogos = {}

@bot.command()
async def adivinhar(ctx):
    numero = random.randint(1, 20)
    # Correção: Definir chaves corretamente como strings e inicializar
    jogos[ctx.author.id] = { "numero": numero, "tentativas": 5 }
    await ctx.send(
        "🎲 Pensei em um número de **1 a 20**.\n"
        "Você tem **5 tentativas**. Envie `$guess <número>`!"
    )

@bot.command()
async def guess(ctx, palpite: int):
    if ctx.author.id not in jogos:
        await ctx.send("❌ Você ainda não iniciou um jogo. Use `$adivinhar` primeiro.")
        return

    jogo = jogos[ctx.author.id]
    # Correção: Acessar a chave 'numero' corretamente
    numero_secreto = jogo["numero"]
    
    # Reduzir tentativa
    jogo["tentativas"] -= 1
    
    if palpite == numero_secreto:
        await ctx.send(f"🎉 **Parabéns! Você acertou!** O número era {numero_secreto}.")
        del jogos[ctx.author.id]
        return

    # Verificar se acabaram as tentativas
    if jogo["tentativas"] <= 0:
        await ctx.send(f"💥 Acabaram as tentativas. O número era **{numero_secreto}**.")
        del jogos[ctx.author.id]
        return

    # Dicas
    if palpite < numero_secreto:
        dica = "maior"
    else:
        dica = "menor"

    await ctx.send(
        f"❌ Errou! O número é **{dica}**.\n"
        f"Tentativas restantes: **{jogo['tentativas']}**"
    ) 

