@bot.command()
async def dado(ctx, dice: str):
    try:
        rolls, limit = map(int, dice.lower().split('d'))

        if rolls <= 0 or limit <= 0:
            await ctx.send("Os valores precisam ser maiores que zero.")
            return
        if rolls > 20:
            await ctx.send("Máximo de 20 dados por vez!")
            return

    except Exception:
        await ctx.send("Use o formato NdN (ex: 2d6)")
        return

    resultados = [random.randint(1, limit) for _ in range(rolls)]
    total = sum(resultados)
    await ctx.send(
        f"🎲 Resultados: {', '.join(map(str, resultados))}\n"
        f" Total: **{total}**"
    )

